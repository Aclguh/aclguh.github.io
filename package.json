{
    "name": "aclguh-workspace",
    "version": "1.0.0",
    "private": true,
    "description": "Personal web tools and micro-games workspace hosted on GitHub Pages",
    "scripts": {
        "test": "node --test",
        "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=70",
        "lint": "eslint .",
        "format": "prettier --write \"**/*.{html,css,js,json,md}\"",
        "format:check": "prettier --check \"**/*.{html,css,js,json,md}\""
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "prettier": "^3.5.3"
    }
}
